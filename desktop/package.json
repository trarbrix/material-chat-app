{
  "name": "material-chat-desktop",
  "productName": "Material Chat",
  "version": "1.0.0-beta.1",
  "description": "Material Chat desktop beta",
  "author": "Material Chat",
  "homepage": "https://github.com/trarbrix/material-chat-app",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux deb rpm --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.materialchat.desktop",
    "productName": "Material Chat",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "local-server.js",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../variant-b.html",
        "to": "variant-b.html"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Material Chat needs microphone access to record voice and video messages.",
        "NSCameraUsageDescription": "Material Chat needs camera access to record video messages."
      }
    },
    "linux": {
      "category": "Network",
      "icon": "assets/icon.png",
      "target": [
        "deb",
        "rpm"
      ],
      "maintainer": "Material Chat"
    }
  }
}
